buat k = impor("./kripto.ns");

fungsi cocok_di(data, offset, pola_hex) {
    buat pola = k.hex_decode(pola_hex);
    jika offset + panjang(pola) > panjang(data) {
        hasil salah;
    }
    hasil potong(data, offset, offset + panjang(pola)) == pola;
}

fungsi deteksi_tipe_file(data) {
    jika cocok_di(data, 0, "89504e470d0a1a0a") {
        hasil "png";
    }
    jika cocok_di(data, 0, "ffd8ff") {
        hasil "jpeg";
    }
    jika cocok_di(data, 0, "474946383761") || cocok_di(data, 0, "474946383961") {
        hasil "gif";
    }
    jika cocok_di(data, 0, "25504446") {
        hasil "pdf";
    }
    jika cocok_di(data, 0, "7f454c46") {
        hasil "elf";
    }
    jika cocok_di(data, 0, "4d5a") {
        hasil "pe-exe";
    }
    jika cocok_di(data, 0, "1f8b") {
        hasil "gzip";
    }
    jika cocok_di(data, 0, "504b0304") || cocok_di(data, 0, "504b0506") || cocok_di(data, 0, "504b0708") {
        hasil "zip";
    }
    hasil "tidak dikenal";
}

fungsi baca_angka_be(data, offset, panjang_byte) {
    buat n = 0;
    untuk (buat i = 0; i < panjang_byte; i = i + 1) {
        n = n * 256 + byte_di(data, offset + i);
    }
    hasil n;
}

fungsi baca_angka_le(data, offset, panjang_byte) {
    buat n = 0;
    buat tempat = 1;
    untuk (buat i = 0; i < panjang_byte; i = i + 1) {
        n = n + byte_di(data, offset + i) * tempat;
        tempat = tempat * 256;
    }
    hasil n;
}

// Payload klasik buat overwrite return address: N byte padding diikuti
// alamat yang di-pack sesuai endian target-nya. `byte_padding` ANGKA
// 0-255 (mis. 65 buat 'A', 144 buat NOP `\x90`) -- bukan teks, soalnya
// bahasa ini gak punya escape `\xNN` buat nulis byte mentah di string
// literal (`"\x90"` jadi 3 karakter teks "x90", bukan 1 byte 0x90).
fungsi bikin_payload(panjang_padding, byte_padding, alamat, panjang_alamat, endian) {
    buat satu_byte = k.hex_decode(k.angka_ke_bytes_be(byte_padding, 1));
    buat padding = "";
    untuk (buat i = 0; i < panjang_padding; i = i + 1) {
        padding = padding + satu_byte;
    }
    buat alamat_hex = k.angka_ke_bytes_be(alamat, panjang_alamat);
    jika endian == "le" {
        alamat_hex = k.angka_ke_bytes_le(alamat, panjang_alamat);
    }
    hasil padding + k.hex_decode(alamat_hex);
}

// LSB/bitplane stego, gambar (BMP 24/32-bit gak terkompresi lewat
// plugin native `gambar`). `channel` satu atau gabungan dari "r"/"g"/
// "b"/"a" (huruf besar/kecil sama), `n_bit` 1-8 (1 = LSB murni).
fungsi lsb_gambar(path, channel, n_bit) {
    buat hex = muat_plugin("gambar").bmp_lsb_extract(path, channel, n_bit);
    jika hex == kosong {
        lempar "lsb_gambar(): gagal -- '" + path + "' harus BMP 24/32-bit gak terkompresi, channel/n_bit valid";
    }
    hasil hex;
}

// Coba semua channel warna sekaligus (r/g/b masing-masing + gabungan
// rgb, plus alpha/rgba kalau gambarnya 32-bit) -- balikin peta
// channel -> hex, biar gak perlu manggil lsb_gambar() satu-satu pas
// belum tau pesannya disembunyiin di channel mana.
fungsi lsb_gambar_semua_channel(path, n_bit) {
    buat g = muat_plugin("gambar");
    buat info = json_decode(g.bmp_info(path));
    jika !info.ok {
        lempar "lsb_gambar_semua_channel(): gagal buka '" + path + "'";
    }
    buat daftar_channel = ["r", "g", "b", "rgb"];
    jika info.bit_depth == 32 {
        tambah(daftar_channel, "a");
        tambah(daftar_channel, "rgba");
    }
    buat keluar = peta_baru();
    untuk (buat i = 0; i < panjang(daftar_channel); i = i + 1) {
        keluar[daftar_channel[i]] = lsb_gambar(path, daftar_channel[i], n_bit);
    }
    hasil keluar;
}

// Simpen ulang gambar dengan cuma satu channel warna aktif ("r"/"g"/
// "b") atau efek "grayscale"/"invert" -- buat ngeliat pola tersembunyi
// yang keliatan mata pas satu channel diisolasi.
fungsi pisah_channel_gambar(path, channel, path_keluaran) {
    hasil muat_plugin("gambar").bmp_filter(path, path_keluaran, channel);
}

// LSB stego audio (WAV PCM mentah, 8/16/24/32-bit, lewat plugin native
// `audio`) -- ekstrak `n_bit` bit terendah dari tiap sample, semua
// channel interleave apa adanya.
fungsi lsb_audio(path, n_bit) {
    buat hex = muat_plugin("audio").wav_lsb_extract(path, n_bit);
    jika hex == kosong {
        lempar "lsb_audio(): gagal -- '" + path + "' harus WAV PCM mentah, n_bit 1-8";
    }
    hasil hex;
}

// LSB stego video: extract tiap frame ke BMP lewat `ffmpeg` (harus
// keinstall di sistem, dipanggil argv-safe lewat jalankan_perintah,
// bukan didekode ulang manual -- gak ada video decoder di sini), terus
// tiap frame dianalisa pake lsb_gambar() yang sama kayak gambar biasa.
// Balikin larik hex per frame (index 0 = frame pertama); berhenti pas
// nemu frame yang gak ada lagi atau udah nyampe `maks_frame`.
fungsi lsb_video(path, dir_frame, channel, n_bit, maks_frame) {
    jalankan_perintah("mkdir", ["-p", dir_frame]);
    buat pola = dir_frame + "/frame_%04d.bmp";
    buat r = jalankan_perintah("ffmpeg", ["-y", "-i", path, pola]);
    jika r.status != 0 {
        lempar "lsb_video(): ffmpeg gagal -- " + r.error;
    }
    buat keluar = [];
    buat i = 1;
    selama i <= maks_frame {
        buat nomor = ke_teks(i);
        selama panjang(nomor) < 4 {
            nomor = "0" + nomor;
        }
        buat frame_path = dir_frame + "/frame_" + nomor + ".bmp";
        jika !file_ada(frame_path) {
            berhenti;
        }
        tambah(keluar, lsb_gambar(frame_path, channel, n_bit));
        i = i + 1;
    }
    hasil keluar;
}

fungsi ekstrak_string(data, panjang_min) {
    buat hasil_akhir = [];
    buat mulai = -1;
    untuk (buat i = 0; i < panjang(data); i = i + 1) {
        buat b = byte_di(data, i);
        buat cetak_bisa = b >= 32 && b <= 126;
        jika cetak_bisa && mulai < 0 {
            mulai = i;
        } lain jika !cetak_bisa && mulai >= 0 {
            jika i - mulai >= panjang_min {
                tambah(hasil_akhir, potong(data, mulai, i));
            }
            mulai = -1;
        }
    }
    jika mulai >= 0 && panjang(data) - mulai >= panjang_min {
        tambah(hasil_akhir, potong(data, mulai, panjang(data)));
    }
    hasil hasil_akhir;
}
